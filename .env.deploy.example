# Modelo do `.env` que fica NA VM, ao lado do docker-compose.yml.
# Copie para `.env` (`cp .env.deploy.example .env`), preencha e nunca comite.
#
# Este arquivo é só do caminho "minha VM". Na Vercel os mesmos valores entram
# em Settings → Environment Variables. Passo a passo: docs/HOSPEDAGEM.md

# O domínio que aponta para a VM. O Caddy pede o certificado para ele e é este
# endereço que vai no application_url do shopify.app.toml.
DVFLY_DOMAIN="dvfly.seudominio.com.br"

# Senha do Postgres do container. Qualquer coisa longa e aleatória; ela só é
# usada entre os containers, nunca sai da VM.
POSTGRES_PASSWORD=""

# Credenciais do app na Shopify (Dev Dashboard → o seu app → Client credentials).
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""

# Chave que criptografa o acesso às lojas dentro do banco.
# Gere com `npm run gerar-chave` e guarde: trocá-la obriga cada loja a abrir o
# app de novo para renovar o acesso.
DVFLY_TOKEN_KEY=""

# Lojas autorizadas a abrir o app, separadas por vírgula. Vazio = qualquer loja
# que a Shopify deixar instalar. Preencha para travar nas suas.
DVFLY_ALLOWED_SHOPS=""

# Versão da Admin API (AAAA-MM). Vazio = a padrão compilada no app.
SHOPIFY_API_VERSION=""
