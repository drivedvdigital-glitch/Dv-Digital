# Banco de dados. SQLite em desenvolvimento; em produção troque para PostgreSQL
# (veja "Colocando em produção" no README).
DATABASE_URL="file:./prisma/dev.db"

# Chave da API da Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""
# Opcionais: padrão claude-opus-5 com esforço medium.
ANTHROPIC_MODEL="claude-opus-5"
ANTHROPIC_EFFORT="medium"

# Segredo exigido no header x-webhook-token das rotas de webhook e de operação.
# TROQUE por um valor aleatório longo — o app recusa as rotas enquanto o valor
# de exemplo estiver aqui.
WEBHOOK_SECRET="troque-este-valor"

# Quantos pedidos os agentes atendem em paralelo.
AGENTES_SIMULTANEOS="3"

# Provedor de WhatsApp: mock | evolution | meta
WHATSAPP_PROVIDER="mock"

# Evolution API (auto-hospedada, funciona com número comum)
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE=""

# Meta WhatsApp Cloud API (oficial, exige número aprovado).
# META_APP_SECRET é obrigatório: é com ele que a assinatura dos webhooks da
# Meta é conferida.
META_PHONE_NUMBER_ID=""
META_ACCESS_TOKEN=""
META_VERIFY_TOKEN=""
META_APP_SECRET=""
