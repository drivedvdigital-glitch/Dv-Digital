            "items": [
              { "title": "Com que frequência chega?", "body": "Você escolhe entre 15, 30 ou 45 dias. Dá para pausar ou pular uma entrega a qualquer momento pelo painel." },
              { "title": "Posso escolher o café?", "body": "Pode. Ou deixe no modo surpresa e a gente manda um lote diferente a cada ciclo, dentro do perfil que você marcou." },
              { "title": "Qual o prazo de entrega?", "body": "De 2 a 5 dias úteis nas capitais e até 9 dias úteis no interior, contados da torra." },
              { "title": "Como cancelo?", "body": "Pelo painel da conta, em dois cliques, sem falar com ninguém e sem multa." },
              { "title": "Vocês moem na hora?", "body": "Moemos no momento do envio, na granulometria que você escolher. Para máxima frescura, recomendamos grão inteiro." },
              { "title": "Tem café descafeinado?", "body": "Temos um lote descafeinado por processo natural com água, sem solvente químico, disponível o ano todo." },
              { "title": "A embalagem é reciclável?", "body": "A caixa é de papelão reciclado e reciclável. O saco tem válvula e é compostável industrialmente." },
              { "title": "Emitem nota fiscal?", "body": "Sim, em todo pedido. A nota vai por e-mail junto com o código de rastreio." }
