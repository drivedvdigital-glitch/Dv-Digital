# HTTPS do D&VFly na VM.
#
# O Caddy pede e renova o certificado sozinho — a Shopify só abre o app dentro
# do admin por HTTPS, e um certificado vencido derruba o app inteiro sem aviso.
#
# `X-Forwarded-Proto` é o que faz o servidor enxergar https onde a conexão
# interna é http. Sem isso o CSRF do React Router recusa todo Salvar e
# Publicar com 400 (armadilha já paga — veja app/server.mjs).
{$DVFLY_DOMAIN} {
	encode zstd gzip

	reverse_proxy {
		# O endereço do app é resolvido A CADA requisição, no DNS do Docker.
		# Publicar recria o container: por um instante o nome "app" não existe,
		# e um destino fixo vira 502 (medido: 1,3 s de erro por publicação).
		# Resolvendo na hora, a requisição espera o nome voltar.
		dynamic a {
			name app
			port 3000
			refresh 1s
			resolvers 127.0.0.11
		}

		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}

		# Nada de checagem ATIVA de saúde aqui. Com um único destino ela só
		# atrapalha: a primeira checagem cai enquanto o app ainda sobe, o
		# destino fica marcado como morto até a próxima rodada e todo mundo
		# leva 503 nesse meio-tempo (medido: 30 s de 503 depois de publicar).
		# Quem responde "está de pé?" é o /healthz, e quem vigia é o
		# healthcheck do container, no docker-compose.yml.
		#
		# Aqui vale o contrário: uma requisição que chega durante o reinício
		# ESPERA o app voltar em vez de falhar.
		lb_try_duration 15s
		lb_try_interval 500ms
	}

	log {
		output stdout
		# A primeira abertura do app carrega ?id_token=… na URL. Um token, por
		# mais curto que seja o prazo dele, não tem lugar num log: o filtro
		# apaga os parâmetros sensíveis antes de a linha ser escrita.
		format filter {
			wrap console
			fields {
				request>uri query {
					delete id_token
					delete session
					delete hmac
				}
			}
		}
	}
}
