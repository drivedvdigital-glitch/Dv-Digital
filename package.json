{
  "name": "dvfly",
  "private": true,
  "type": "module",
  "description": "D&VFly — construtor visual de páginas para Shopify.",
  "engines": {
    "node": ">=22.6"
  },
  "workspaces": [
    "app",
    "packages/*"
  ],
  "scripts": {
    "setup": "npm install && node scripts/preflight.mjs && npm run db:setup --workspace @dvfly/app",
    "fix:duplicados": "node scripts/preflight.mjs --fix",
    "predev": "node scripts/preflight.mjs && node app/scripts/ensure-env.mjs",
    "dev": "npm run dev --workspace @dvfly/app",
    "build": "npm run build --workspace @dvfly/app",
    "start": "npm run start --workspace @dvfly/app",
    "typecheck": "tsc --noEmit -p app",
    "test": "npm run test --workspace @dvfly/compiler && npm run test --workspace @dvfly/shopify && npm run test --workspace @dvfly/app",
    "db:deploy": "npm run db:deploy --workspace @dvfly/app",
    "gerar-chave": "node scripts/generate-key.mjs",
    "migrar-dados": "node --experimental-strip-types --experimental-sqlite scripts/import-local-database.mjs"
  },
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "prisma": true,
    "esbuild": true
  }
}
