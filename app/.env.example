# Local development database. SQLite file, created by `npm run setup`.
DATABASE_URL="file:./dev.db"

# The app's client credentials, from the Shopify dev dashboard. Needed so the
# FIRST store can register itself when it opens the app; after that, any
# registered store's pair would also do (same app everywhere). Values live
# only in each machine's untracked .env — GitHub's push protection rightly
# refuses to let the real secret into the repository.
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""
