# Banco. Na sua máquina é um arquivo SQLite, criado pelo `npm run setup`
# (caminho relativo resolve a partir de app/prisma/). No servidor é um Postgres:
# basta trocar por "postgresql://usuario:senha@servidor:5432/dvfly" — o schema do
# Prisma se ajusta sozinho ao que estiver aqui (app/scripts/prisma-schema.mjs).
# Passo a passo de hospedagem: docs/HOSPEDAGEM.md
DATABASE_URL="file:./dev.db"

# Só no servidor, e só quando o Postgres for atrás de um pooler (Neon, Supabase,
# pgbouncer): o endereço DIRETO do banco, que é por onde as migrations passam.
DATABASE_URL_DIRECT=""

# Chave que criptografa o acesso às lojas dentro do banco (32 bytes em base64).
# Gere com `npm run gerar-chave`. Vazio na sua máquina é aceito; EM PRODUÇÃO o
# app se recusa a subir sem ela — a documentação da Shopify pede que o token de
# cada loja seja guardado criptografado.
DVFLY_TOKEN_KEY=""

# The app's client credentials, from the Shopify Dev Dashboard. Needed so the
# FIRST store can register itself when it opens the app; in development, any
# registered store's pair also works (same app everywhere). In production they
# are REQUIRED here — the app refuses to boot without them. Values live only in
# each machine's untracked .env — GitHub's push protection rightly refuses to
# let the real secret into the repository.
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""

# Admin API version (YYYY-MM, quarterly). Shopify retires each version about
# 12 months after release and silently answers with the oldest supported one
# when the pinned version is gone — the app logs a warning when that happens.
# Leave empty to use the compiled-in default.
SHOPIFY_API_VERSION=""

# Extra origins allowed to POST to the app's actions (comma-separated). The
# dev tunnel needs it (https origin × http server). Defaults to the tunnel
# domain in development and to NOTHING in production. Read at BUILD time
# (react-router.config.ts): setting it on the host after `npm run build`
# changes nothing. Production does not need it: server.mjs trusts the proxy.
# Empty = the default above (the tunnel domain).
DVFLY_DEV_ORIGINS=""

# Every request must carry a Shopify ID token (the app opened from the admin).
# "off" disables that for LOCAL development only — opening localhost directly
# or driving the app with Playwright. Production ignores this switch.
DVFLY_AUTH=""

# Shops allowed to open (and install) the app, comma-separated myshopify
# domains. Empty = any shop Shopify lets install it (right for a custom app,
# which Shopify already ties to one store or organization).
DVFLY_ALLOWED_SHOPS=""

# Production only (app/server.mjs): NODE_ENV=production, PORT, HOST.
