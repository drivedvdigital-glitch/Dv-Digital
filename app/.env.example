# Local development database. SQLite file, created by `npm run setup`.
DATABASE_URL="file:./dev.db"

# Optional: the app's client credentials, from the Shopify dev dashboard.
# When absent, the app reuses the credentials of any store already registered —
# every store runs the same app, so the pair is the same. Only a completely
# empty database with no environment pair needs these filled in.
# SHOPIFY_CLIENT_ID=""
# SHOPIFY_CLIENT_SECRET=""
