// Data model for D&VFly. See docs/ARQUITETURA.md section 4.
//
// THIS IS THE SOURCE FILE. `prisma/schema.prisma` is generated from it by
// `app/scripts/prisma-schema.mjs` and is not in git: the datasource block is
// the one thing that differs between a laptop (SQLite file, zero setup) and a
// server (Postgres, which is the only kind of database a hosted app can have —
// a serverless filesystem is thrown away between deployments).
//
// The models below are shared by both, byte for byte.
// <<GENERATOR>>

// <<DATASOURCE>>

/// A Shopify store this installation can publish to.
///
/// Two ways a store gets here: it INSTALLED the app (Shopify-managed
/// installation → token exchange → `accessToken`, the normal path for any
/// store), or it belongs to the app's own organization and is reached with
/// the app's client credentials (`clientId`/`clientSecret`, legacy per-row
/// copies kept for the stores registered that way).
model Store {
  id            String       @id @default(cuid())
  domain        String       @unique
  label         String
  clientId      String?
  clientSecret  String?
  /// Offline access token from the token exchange; null until installed.
  accessToken   String?
  /// When the token stops working (apps set to expiring offline tokens);
  /// null for a token that does not expire. Renewed on the next open.
  tokenExpiresAt DateTime?
  /// Scopes granted at install, comma-separated, as Shopify reported them.
  scopes        String?
  installedAt   DateTime?
  /// Set by the app/uninstalled webhook; the row stays so pages keep history.
  uninstalledAt DateTime?
  /// When someone typed the access key (DVFLY_ACCESS_KEY) for this store.
  /// Null means the store still has to. Meaningless while no key is set —
  /// installing is then enough, as it was before the lock existed.
  authorizedAt  DateTime?
  isProduction  Boolean      @default(false)
  createdAt     DateTime     @default(now())
  deployments   Deployment[]
  productLinks  ProductLink[]
  /// Pages created from this store's admin. See `Page.ownerStore`.
  ownedPages    Page[]       @relation("PaginasDaLoja")
  abTests       AbTest[]
  abOrders      AbOrder[]
  /// How far the light copy of this store's orders is synced (`updated_at`
  /// of the last change read). Null: never synced.
  ordersSyncedTo DateTime?
}

/// A page is authored once and deployed to many stores. It deliberately does
/// not BELONG to a store — that is the difference between "export and import"
/// and multi-store publishing as a first-class operation.
///
/// What it does have is an owner: the store whose admin it was created from.
/// That is a filing rule, not an ownership rule — it decides which list the
/// page shows up in first, and nothing else. Publishing still reaches any
/// store, and the list has a tab that shows every page regardless of owner,
/// because a page you cannot find is worse than a list that is too long.
model Page {
  id        String    @id @default(cuid())
  /// The store this page was created from. Null for pages that predate the
  /// column and were never published anywhere — those show in every list, so
  /// nothing written before this existed can go missing. `SetNull` on delete:
  /// forgetting a store must never delete the pages authored from it.
  ownerStoreId String?
  ownerStore   Store?  @relation("PaginasDaLoja", fields: [ownerStoreId], references: [id], onDelete: SetNull)
  title     String
  handle    String
  /// Block document as JSON. For now usually a single html block.
  doc       String
  /// "regular" | "product" — what kind of storefront page this becomes.
  pageType  String    @default("regular")
  /// Show the theme's header and footer. When false, publishing binds the
  /// page to the D&VFly minimal layout (templates written into the theme).
  /// Off by default since 22/09: the lightest page is the default page, and
  /// the theme's chrome (with the CSS and JS its layout drags in) is opt-in.
  showChrome Boolean  @default(false)
  /// Product pages only: place the D&VFly content above the theme's own
  /// product sections (price, variants, buy) instead of below them.
  productContentAbove Boolean @default(false)
  /// Product pages only: our section alone on the minimal D&VFly layout —
  /// no theme product sections, none of the theme's CSS or JS. For a landing
  /// page that brings its own everything. Shopify's head and app embeds stay.
  /// On by default (same reason as `showChrome`); the setting turns it off.
  bareLayout Boolean @default(true)
  /// What a `rem` in pasted HTML is worth. Off (default): the browser's 16px,
  /// the size the page shows in any standalone preview — the look approved on
  /// 22/09. On: the store theme's root (10px on Shopify's themes), for a page
  /// designed inside the theme. Preview and publish read the same flag (I1).
  remFromTheme Boolean @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  versions  Version[]

  deployments  Deployment[]
  productLinks ProductLink[]

  // The page list filters by owner. Created by migration
  // 20260921190000_pagina_por_loja; declared here so the schema matches it.
  @@index([ownerStoreId])
}

/// A product page is a theme template; the products that adopt it are linked
/// here, per store (product ids differ from store to store). Publishing sets
/// each linked product's templateSuffix; unpublishing clears it.
model ProductLink {
  id            String   @id @default(cuid())
  pageId        String
  page          Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productGid    String
  productHandle String
  productTitle  String
  createdAt     DateTime @default(now())

  @@unique([pageId, storeId, productGid])
}

/// Every save is a version. compilerVersion is invariant I2 as a column:
/// updating the builder never rewrites a page that was already published.
model Version {
  id              String   @id @default(cuid())
  pageId          String
  page            Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  doc             String
  compilerVersion String
  label           String?
  createdAt       DateTime @default(now())

  deployments Deployment[]
}

/// One page, on one store, at one version. Stores the compiled output so a
/// republish is byte-identical and an export needs no recompilation.
model Deployment {
  id          String   @id @default(cuid())
  pageId      String
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  versionId   String
  version     Version  @relation(fields: [versionId], references: [id], onDelete: Cascade)
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shopifyGid  String
  isPublished Boolean  @default(false)
  bytes       Int
  publishedAt DateTime @default(now())

  @@unique([pageId, storeId])
}

/// "Teste A | B": one product URL of a store that sends each visitor to one of
/// several product pages, by weight (packages/shopify/src/split.ts). The
/// entry product is pointed at a template of ours while the test is live;
/// pausing gives it back the template it had (`previousSuffix`).
model AbTest {
  id              String      @id @default(cuid())
  storeId         String
  store           Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name            String
  /// The product whose URL the ads point at (`/products/piadebanho`).
  entryProductGid String
  entryHandle     String
  entryTitle      String
  /// The suffix the entry product rendered with before the test took it over.
  previousSuffix  String?
  /// "draft" (never went live) | "live" | "paused" | "ended" (a winner was chosen).
  status          String      @default("draft")
  /// Ended with a winner that took over the entry URL: the variant whose
  /// product swapped handles with the entry product (undo swaps them back).
  promotedVariantId String?
  /// Where the storefront script reports arrivals: this app's public origin,
  /// recorded when the test goes live.
  trackerOrigin   String?
  startedAt       DateTime?
  /// The latest arrival counted (written with the batched counts, at most
  /// every few seconds): the screen says how long ago, so a count that
  /// stopped shows at a glance.
  lastHitAt       DateTime?
  /// How version A is shown when it is the entry URL itself: "stay" (the
  /// entry renders A's page with the split in its head — no redirect for A)
  /// or "view" (A is reached through a redirect to `?view=`, when A's
  /// template has no layout to carry the split). Null while not live.
  entryMode       String?
  /// What was observed about version A's page at the last write: why it is
  /// not on its own page, or that its template is gone. Null when nothing.
  entryModeNote   String?
  /// The stretches the test was live, as JSON `[[start, end|null], …]`.
  /// Clicks only accrue while live, so orders only count inside them: while
  /// paused the entry shows its own page to all the traffic.
  liveSpans       String?
  /// The last write to the store failed after the settings were saved: the
  /// store still runs the previous ones. Cleared by the next write that works.
  applyError      String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  variants        AbVariant[]

  @@index([storeId])
}

/// One version of a test: another product of the same store, with its share
/// of the visitors. Orders are attributed by this product (orders.ts).
model AbVariant {
  id         String   @id @default(cuid())
  testId     String
  test       AbTest   @relation(fields: [testId], references: [id], onDelete: Cascade)
  productGid String
  handle     String
  title      String
  /// Percent of the visitors (the variants of a test add up to 100).
  weight     Int
  position   Int
  stats      AbStat[]
}

/// Arrivals per variant per hour (UTC). Hours, not days: the report counts
/// days in the STORE's timezone, which is only known when someone reads it.
model AbStat {
  variantId String
  variant   AbVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  testId    String
  hour      DateTime
  /// Every arrival through the test URL.
  clicks    Int       @default(0)
  /// First arrivals of a browser (the variant was drawn, not remembered).
  visitors  Int       @default(0)

  @@id([variantId, hour])
  @@index([testId, hour])
}

/// A light copy of a store's orders, for the A/B report: Shopify's order
/// search cannot filter by product, so the report counts here. No customer
/// data — id, dates, total and the products in it. Synced by `updated_at`
/// (orders.ts), so a cancellation reaches the copy too.
model AbOrder {
  /// The order's GID.
  id         String   @id
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt  DateTime
  cancelled  Boolean
  test       Boolean
  total      Float
  currency   String
  /// Product GIDs in the order, space-separated.
  productIds String

  @@index([storeId, createdAt])
}
